{
  "manifest_version": 3,
  "name": "Orion — Assistente Neural",
  "version": "5.6.0",
  "description": "Assistente IA neural multi-agente com Vertex AI, visão, fala, raciocínio, pesquisa web, scraping, holographic video, pro-active research assistant, side panel, tradução, notas, bookmarks, anti-alucinação, YouTube PiP, PDF/image upload e auto-minimize.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting",
    "sidePanel",
    "contextMenus",
    "notifications",
    "offscreen",
    "alarms",
    "clipboardRead",
    "clipboardWrite",
    "downloads",
    "bookmarks",
    "history",
    "tts",
    "readingList",
    "webNavigation"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon128.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon128.png",
    "128": "icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+O", "mac": "Command+Shift+O" },
      "description": "Abrir Orion"
    },
    "toggle-listening": {
      "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" },
      "description": "Ativar/desativar escuta"
    },
    "open-side-panel": {
      "suggested_key": { "default": "Ctrl+Shift+P", "mac": "Command+Shift+P" },
      "description": "Abrir painel lateral"
    },
    "quick-screenshot": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Captura rápida de tela"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icon128.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
