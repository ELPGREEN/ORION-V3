{
  "manifest_version": 3,
  "name": "Orion — Assistente Neural (V6)",
  "version": "6.1.0",
  "description": "Assistente IA neural com Roteamento Híbrido (Ollama + OpenRouter), NemoClaw Sandbox e Aceleração WebGPU.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting",
    "sidePanel",
    "contextMenus",
    "notifications",
    "offscreen",
    "alarms",
    "clipboardRead",
    "clipboardWrite",
    "downloads",
    "bookmarks",
    "history",
    "tts"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icon128.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
