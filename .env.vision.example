# ═══ Orion V3 Vision Performance Configuration ═══
# Optimize real-time vision pipeline

# Gemini Flash throttle (ms) — lower = faster updates, higher = less API calls
# Default: 1000 (1 second) — Previous: 6000 (6 seconds)
VITE_VISION_GEMINI_THROTTLE=1000

# MediaPipe detection frameskip — process every N frames
# Lower = more detections, higher = better performance
# Default: 10 (3 FPS detection at 30 FPS video)
VITE_VISION_MEDIAPIPE_FRAMESKIP=10

# SuperNet frame transmission — process every N frames
# Default: 15 (2 FPS at 30 FPS video)
VITE_VISION_SUPERNET_FRAMESKIP=15

# Local processing frameskip (useVisionProcessing)
# Default: 3 (10 FPS local processing at 30 FPS video)
VITE_VISION_LOCAL_FRAMESKIP=3

# Camera resolution (max width)
VITE_VISION_MAX_WIDTH=640

# Camera target FPS
VITE_VISION_TARGET_FPS=30
