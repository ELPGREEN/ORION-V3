# ═══ Orion LLM API Keys Configuration ═══
# Copy this file to .env and fill in your API keys
# Only providers with keys will be available

# ─── Free Tier Providers (require API key) ───
# DeepSeek - Free tier available!
VITE_DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Groq - Free tier available!
VITE_GROQ_API_KEY=

# OpenRouter - Free tier available!
VITE_OPENROUTER_API_KEY=

# HuggingFace - Free tier available!
VITE_HUGGINGFACE_API_KEY=

# ─── Paid Providers ───
VITE_OPENAI_API_KEY=
VITE_ANTHROPIC_API_KEY=
VITE_GOOGLE_API_KEY=
VITE_COHERE_API_KEY=
VITE_MISTRAL_API_KEY=
VITE_FIREWORKS_API_KEY=
VITE_TOGETHER_API_KEY=

# ─── Local Models (no API key needed) ───
# Ollama must be running locally: ollama serve
# LM Studio must be running locally
# llama.cpp must be running locally

# ─── Cloud Services ───
VITE_AZURE_API_KEY=
VITE_VERTEX_API_KEY=