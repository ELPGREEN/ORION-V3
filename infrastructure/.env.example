# ═══════════════════════════════════════════════════════════
#  ORION Robotic Line — Environment Configuration
# ═══════════════════════════════════════════════════════════

# ROS2
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# ROSBridge
ROSBRIDGE_PORT=9090
ROSBRIDGE_SSL=false
ROSBRIDGE_CERT=
ROSBRIDGE_KEY=

# WebRTC Camera
CAMERA_DEVICE=/dev/video0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
WEBRTC_PORT=8443
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USER=
TURN_PASS=

# MQTT
MQTT_PORT=1883
MQTT_WS_PORT=8083
MQTT_HOST=localhost

# InfluxDB
INFLUXDB_PORT=8086
INFLUX_USER=orion
INFLUX_PASS=orion_telemetry_2024
INFLUX_ORG=orion-robotics
INFLUX_BUCKET=robot_telemetry
INFLUX_TOKEN=orion-super-secret-token

# Grafana
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASS=orion2024

# Node-RED
NODERED_PORT=1880

# Foxglove
FOXGLOVE_PORT=8765
